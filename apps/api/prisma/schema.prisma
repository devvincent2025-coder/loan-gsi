model AnomalyRecord {
  id           String          @id @default(cuid())
  detectedAt   DateTime        @default(now())
  metric       String
  dimension    String?         // e.g. branchId, bankCode, officerId
  severity     AnomalySeverity
  status       AnomalyStatus   @default(OPEN)
  zScore       Float?
  baseline     Float?
  actual       Float?
  description  String          @db.Text
  llmExplanation String?       @db.Text
  llmActions   Json?
  acknowledgedById String?
  acknowledgedAt   DateTime?
  resolvedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([detectedAt, severity])
  @@index([status, severity])
  @@index([metric, dimension])
}

model ExecutiveBriefing {
  id             String         @id @default(cuid())
  briefingType   BriefingType
  status         BriefingStatus @default(DRAFT)
  periodStart    DateTime
  periodEnd      DateTime
  targetRoleKey  String?        // null = all exec roles; set to a specific role key to limit
  targetBranchId String?        // null = portfolio-wide; set to scope to a branch
  headline       String         @db.Text
  bodyMd         String?        @db.MediumText
  metricsSnapshot Json?
  anomalyIds     Json?          // string[] of AnomalyRecord.id referenced in the brief
  promptVersion  String         @default("v1")
  modelUsed      String?
  promptTokens   Int            @default(0)
  completionTokens Int          @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  chatMessages   ExecChatMessage[]

  @@index([briefingType, createdAt])
  @@index([status, briefingType])
  @@index([targetBranchId])
}

model ExecChatSession {
  id         String   @id @default(cuid())
  userId     String
  title      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  messages ExecChatMessage[]

  @@index([userId, createdAt])
}

model ExecChatMessage {
  id         String    @id @default(cuid())
  sessionId  String
  briefingId String?
  role       String    // "user" | "assistant"
  content    String    @db.MediumText
  toolCalls  Json?
  toolResults Json?
  pinned     Boolean   @default(false)
  promptTokens Int     @default(0)
  completionTokens Int @default(0)
  createdAt  DateTime  @default(now())

  session    ExecChatSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  briefing   ExecutiveBriefing? @relation(fields: [briefingId], references: [id])

  @@index([sessionId, createdAt])
  @@index([pinned])
}

model ExecPreference {
  id              String   @id @default(cuid())
  userId          String   @unique
  briefingTime    String   @default("07:00")
  channels        Json     @default("[]")
  verbosity       String   @default("standard")
  timezone        String   @default("Africa/Lagos")
  updatedAt       DateTime @updatedAt
}
