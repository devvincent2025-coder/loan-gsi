# ───────── Core ─────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
DATABASE_URL=mysql://damez:damez@localhost:3306/damez
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:3000

# ───────── Web ─────────
# Where the Next.js server proxies /api/* to
API_INTERNAL_URL=http://localhost:4000
# Shows the demo account picker + auto-fill 2FA on the login page. NEVER true in production.
NEXT_PUBLIC_DEMO_MODE=true

# ───────── Auth & sessions ─────────
# 32+ chars. Generate: openssl rand -base64 48
SESSION_SECRET=dev-only-session-secret-change-me-0123456789abcdef
COOKIE_SECURE=false
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=43200
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
TOTP_ISSUER=Damez Loan

# ───────── Field-level encryption (PII) ─────────
# "kid:base64(32 bytes)[,kid2:...]". Generate a key: openssl rand -base64 32
ENCRYPTION_KEYS=v1:ZGV2LW9ubHktZW5jcnlwdGlvbi1rZXktMzJieXRlcyE=
ENCRYPTION_ACTIVE_KEY=v1
BLIND_INDEX_KEY=dev-only-blind-index-key-change-me-0123456789

# ───────── Demo mode (disabled automatically in production) ─────────
DEMO_MODE=true
DEMO_TOTP_SECRET=JBSWY3DPEHPK3PXP

# ───────── Rate limiting ─────────
THROTTLE_LIMIT=300
THROTTLE_TTL_SECONDS=60
AUTH_THROTTLE_LIMIT=10

# ───────── Notifications (mock by default; see apps/api/src/notifications/providers.ts) ─────────
SMS_PROVIDER=mock            # mock | termii | africastalking
EMAIL_PROVIDER=mock          # mock | resend
WHATSAPP_PROVIDER=mock       # mock | termii | meta
TERMII_API_KEY=
TERMII_SENDER_ID=Damez
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
RESEND_API_KEY=
EMAIL_FROM="Damez Loan <no-reply@damez.ng>"
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_ID=

# ───────── Observability ─────────
ERROR_TRACKER=console        # console | sentry
SENTRY_DSN=

# ───────── Customer portal ─────────
PORTAL_SESSION_IDLE_SECONDS=1800
PORTAL_SESSION_ABSOLUTE_SECONDS=86400
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=45

# ───────── KYC: Dojah only, no mock fallback ─────────
DOJAH_BASE_URL=https://sandbox.dojah.io   # production: https://api.dojah.io
DOJAH_APP_ID=
DOJAH_PUBLIC_KEY=
DOJAH_SECRET_KEY=
DOJAH_WIDGET_ID=                       # Face KYC / liveness widget configured in the Dojah dashboard
DOJAH_WEBHOOK_SECRET=                  # HMAC secret for /api/v1/webhooks/dojah
DOJAH_WIDGET_SCRIPT_URL=https://widget.dojah.io/widget.js
# Screening (sanctions/PEP): Dojah AML, same credentials as the rest of KYC above — no mock fallback.
# Bank statement analysis: Dojah by default (no mock); Mono remains an unfinished alternate live adapter.
BANK_STATEMENT_PROVIDER=dojah          # mono | dojah
MONO_SECRET_KEY=

# ───────── Documents: S3-compatible storage + virus scan ─────────
STORAGE_PROVIDER=mock                  # mock (local dir) | s3
STORAGE_LOCAL_DIR=.storage
S3_ENDPOINT=                           # e.g. https://s3.af-south-1.amazonaws.com or a MinIO URL
S3_REGION=af-south-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
VIRUS_SCAN_PROVIDER=mock               # mock (EICAR detector) | clamav
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# ───────── Credit bureau + BVN lookup: Interswitch only, no mock fallback ─────────
# Credit History Lookup (sources CRC + FirstCentral in one call) + BVN Full Details. Sandbox base URL filled in;
# get CLIENT_ID/CLIENT_SECRET from the Interswitch API Marketplace.
INTERSWITCH_BASE_URL=https://sandbox.interswitchng.com/marketplace-routing/api
INTERSWITCH_CLIENT_ID=
INTERSWITCH_CLIENT_SECRET=

# ───────── Webhooks ─────────
WEBHOOK_SIGNING_SECRET=dev-only-webhook-secret

# ───────── Disbursement (NIBSS NIP via a payment provider) ─────────
PAYMENT_PROVIDER=mock                  # mock | paystack | flutterwave | mono
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
MONO_BASE_URL=https://api.withmono.com
MONO_SECRET_KEY=
MONO_WEBHOOK_SECRET=
DISBURSEMENT_MAX_RETRIES=3

# ───────── Linked accounts (open banking ownership verification) ─────────
MONO_CONNECT_PROVIDER=mock             # mock | mono
MONO_CONNECT_PUBLIC_KEY=
AUTODEBIT_MIN_LINKED_ACCOUNTS=2        # additional accounts required beyond the primary repayment account

# ───────── Autodebit mandates (NIBSS e-Mandate, card tokenization) & CBN GSI fallback ─────────
NIBSS_EMANDATE_PROVIDER=mock           # mock | live
NIBSS_BASE_URL=
NIBSS_API_KEY=
NIBSS_CLIENT_ID=
GSI_PROVIDER=mock                      # mock | live (requires CBN/NIBSS GSI access; see ASSUMPTIONS.md)
GSI_BASE_URL=
GSI_API_KEY=
AUTODEBIT_RETRY_LADDER=DUE_AM,DUE_PM,DAY_PLUS_1,DAY_PLUS_3,DAY_PLUS_7_GSI

# ───────── Offers ─────────
OFFER_EXPIRY_HOURS=72
OFFER_COOLING_OFF_HOURS=48             # FCCPC cooling-off window

# ───────── LLM Gateway (Prompt 4) ─────────
LLM_PROVIDER=mock                      # mock | anthropic
ANTHROPIC_API_KEY=                     # required if LLM_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-haiku-5-5       # model ID for LLM calls
LLM_ENABLED=false                      # master switch; false = no LLM calls, returns placeholder
LLM_BUDGET_USD_MONTHLY=50             # soft budget cap (informational; not enforced automatically)
LLM_MIN_GROUP_SIZE=5                   # minimum cohort size before behavioural summaries fire

# ───────── PII Vault (Prompt 4) ─────────
# PII_VAULT_MASTER_KEY=                # 32-byte base64url key; defaults to first ENCRYPTION_KEY if unset
PII_TOKEN_CANARY_SEED=dev-canary-seed-2026   # seed for canary token generation (change in prod)

# ───────── Collections (Prompt 4) ─────────
COLLECTIONS_AUTO_ASSIGN=true           # auto-assign cases to least-loaded agent
EARLY_WARNING_DAYS_AHEAD=7             # days ahead to flag loans approaching delinquency
BEHAVIOUR_SNAPSHOT_CRON=0 2 * * *     # daily at 02:00 Africa/Lagos
EARLY_WARNING_CRON=0 3 * * *          # daily at 03:00 Africa/Lagos

# ───────── Supervisory Intelligence (Phase 5) ─────────
LLM_MODEL_REASONING=claude-opus-5-5   # model for reasoning-heavy briefing generation
LLM_MODEL_FAST=claude-haiku-5-5       # model for fast/cheap tool calls and anomaly explanations
DB_READ_URL=                           # optional read replica URL; falls back to DATABASE_URL if unset
BRIEFING_CRON_DAILY=0 6 * * *         # morning briefing generation: 06:00 Africa/Lagos
BRIEFING_CRON_WEEKLY=0 7 * * 1        # weekly summary: Monday 07:00 Africa/Lagos
BRIEFING_CRON_MONTHLY=0 7 1 * *       # monthly board pack: 1st of month 07:00 Africa/Lagos
METRICS_AGGREGATION_CRON=0 1 * * *    # portfolio snapshot aggregation: 01:00 Africa/Lagos
ANOMALY_DETECTION_CRON=0 4 * * *      # anomaly detection run: 04:00 Africa/Lagos
LLM_MAX_TOOL_LOOPS=5                   # max tool-call iterations per LLM agent loop
LLM_BUDGET_USD_DAILY=5                 # soft daily spend cap in USD (informational)
BRIEFING_ENABLED=true                  # master switch for executive briefing generation
BOARD_PACK_ENABLED=true                # enable monthly board pack generation
EXEC_PROMPT_VERSION=v1                 # prompt version tag recorded on each briefing
EXEC_ALERT_EMAIL_ENABLED=false         # send urgent anomaly alerts via email
ANOMALY_ZCORE_THRESHOLD=2.5            # z-score threshold above which an anomaly is flagged
ANOMALY_MIN_PERIODS=7                  # minimum historical periods required before anomaly detection fires
